{
  "routes": [
    {
      "src": "/(.*)",
      "headers": { "Vary": "Accept, Accept-Encoding" },
      "continue": true
    },
    {
      "src": "/(.*)",
      "has": [
        { "type": "header", "key": "accept", "value": ".*text/markdown.*" }
      ],
      "dest": "/llms.txt",
      "headers": { "Content-Type": "text/markdown; charset=utf-8" }
    },
    { "handle": "filesystem" },
    { "src": "/.well-known/mcp", "dest": "/api/mcp" },
    { "src": "^/(projects|work-projects|blogs)/?$", "dest": "/index.html" }
  ]
}
